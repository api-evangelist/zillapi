        {
          "id": "d1dd9f58-cc76-4845-a2b8-923beb983e9f",
          "name": "Search listings by bounding box",
          "request": {
            "name": "Search listings by bounding box",
            "description": {
              "content": "REST GET wrapper over /v1/search for one-line curl or agent-toolchain use. A `bbox` (west,south,east,north) is REQUIRED — free-text location is not supported. Returns up to 50 rows synchronously; for more, use POST /v1/search with async. Billed at 1 credit per listing returned; failed calls are free.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "listings"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "status",
                  "value": "for_sale",
                  "description": "Listing status preset."
                },
                {
                  "disabled": false,
                  "key": "bbox",
                  "value": "<string>",
                  "description": "(Required) REQUIRED bounding box as `west,south,east,north` (decimal degrees, comma-separated). A free-text location alone is not accepted and returns 400 missing_input; the search engine needs a real bounding box."
                },
                {
                  "disabled": false,
                  "key": "price_min",
                  "value": "<integer>",
                  "description": "Minimum price in dollars."
                },
                {
                  "disabled": false,
                  "key": "price_max",
                  "value": "<integer>",
                  "description": "Maximum price in dollars."
                },
                {
