          "name": "Get all units in a building",
          "request": {
            "name": "Get all units in a building",
            "description": {
              "content": "Extract all unit listings from a Zillow building, apartments, or community URL (/b/, /apartments/, or /community/). Runs synchronously by default; set sync=false for large buildings to receive a job_id. Billed at 1 credit per unit returned; failed calls are free.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "buildings",
                "by-url"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "url",
                  "value": "<string>",
                  "description": "(Required) Building/apartments/community URL (must be /b/, /apartments/, or /community/)."
                },
                {
                  "disabled": false,
                  "key": "include_units",
                  "value": "all",
                  "description": "Which units to include."
                },
                {
                  "disabled": false,
                  "key": "sync",
                  "value": "true",
                  "description": "When true (default) returns units synchronously. Set false for large buildings to run async and return a job_id."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
